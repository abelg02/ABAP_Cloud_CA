{
  "global": {
    "files": "/src/**/*.*",
    "exclude": ["/src/zdemo_role.sia8.xml"],
    "skipGeneratedGatewayClasses": true,
    "skipGeneratedPersistentClasses": true,
    "skipGeneratedFunctionGroups": true
  },
  "dependencies": [
    {
      "url": "https://github.com/abapedia/steampunk-2305-api",
      "folder": "/deps",
      "files": "/src/**/*.*"
    }
  ],
  "syntax": {
    "version": "Cloud",
    "errorNamespace": "^(Z|Y|LCL_|TY_|LIF_)"
  },
  "rules": {
    "parser_error": true,
    "check_syntax": true,
    "unknown_types": true,
    "check_ddic": {
      "exclude": ["ezemp_c07_c08\.enqu", "ztt_emp_addr_c07_c08\.ttyp", "zafcarrc12\.auth"]
    },
    "cloud_types": true,
    "obsolete_statement": true,
    "empty_statement": true,
    "sql_escape_host_variables": true,
    "strict_sql": true,
    "line_length": { "length": 160 }
  }
}
